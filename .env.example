PORT=8080
VPN_GATE_SOURCE_URL=https://www.vpngate.net/api/iphone/
VPN_GATE_HTML_URL=https://www.vpngate.net/en/
VPN_GATE_REFRESH_INTERVAL_SECONDS=300
VPN_GATE_FETCH_TIMEOUT_SECONDS=30
VPN_GATE_CACHE_PATH=/app/data/vpngate-cache.json
HEALTH_SNAPSHOT_PATH=/app/data/server-health.json
VPN_GATE_MAX_STALE_SECONDS=86400
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_HOSTS=*
PROBER_SHARED_SECRET=
PROBER_API_BASE_URL=http://api:8080
PROBER_SWEEP_INTERVAL_SECONDS=900
PROBER_INITIAL_JITTER_SECONDS=30
PROBER_CONCURRENCY=2
PROBER_PROBE_TIMEOUT_SECONDS=35
PROBER_CONFIG_REQUEST_INTERVAL_MS=1100
PROBER_MAX_SERVERS_PER_SWEEP=25
PROBER_RUN_ONCE=false
PROBER_DRY_RUN=false

# SPD admin/account storage (independent of catalog and health snapshots).
SPD_DATABASE_PATH=/app/data/premium.sqlite
PANEL_CONTENT_PATH=/app/data/panel-content.json
SPD_ADMIN_ORIGIN=https://admin.example.invalid
SPD_ADMIN_SESSION_SECONDS=43200
SPD_ACCESS_TOKEN_SECONDS=900
SPD_REFRESH_TOKEN_SECONDS=2592000
# Initial finite quota for all three seeded plans: 100 GiB; change per plan in the panel.
SPD_DEFAULT_QUOTA_BYTES=107374182400
# Keep all three empty until a real, authorized PasarGuard v5.4.1 is configured.
PASARGUARD_BASE_URL=
PASARGUARD_USERNAME=
PASARGUARD_PASSWORD=
PASARGUARD_GROUP_IDS=
PASARGUARD_TIMEOUT_MS=10000
# Local process only, not forwarded by production compose:
SPD_ADMIN_INSECURE_LOCAL=false
PASARGUARD_ALLOW_LOCAL_HTTP=false
